# Server Configuration
PORT=5000
NODE_ENV=development

# Option 1: Gmail App Password Configuration (Simplest for Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Option 2: Custom SMTP Server Configuration (Overrides Option 1 when provided)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Optional Recipient / Sender Overrides (Defaults to EMAIL_USER / SMTP_USER)
# CONTACT_TO_EMAIL=sahinmondal7@gmail.com
# CONTACT_FROM_EMAIL=your_email@gmail.com

