# ============================================================================
# BUILD-TIME FRONTEND VARIABLES (Safe for Vite static build)
# Never place API keys, passwords, or private secrets in VITE_* variables!
# ============================================================================

# Production Portfolio Domain (Used for Canonical URLs, Open Graph tags, JSON-LD, robots.txt & sitemap.xml)
# Do NOT set this to localhost in production.
VITE_SITE_URL=https://sahinmondal.com

# Optional API Base URL Override
# Leave empty for Cloudflare Pages (where `/api/contact` runs on the same domain via Cloudflare Pages Functions)
# and for local development (`npm run dev` / `npm run preview`).
VITE_API_BASE_URL=
